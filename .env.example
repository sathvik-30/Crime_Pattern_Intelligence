# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed -- every module under /analytics reads its DB
# credentials from these environment variables via python-dotenv, never
# hardcoded in source.

CPI_DB_HOST=localhost
CPI_DB_PORT=5432
CPI_DB_NAME=crime_pattern_intelligence
CPI_DB_USER=cpi_user
CPI_DB_PASSWORD=cpi_password
