# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed -- db/seed/generate_seed_data.py and every
# module under /analytics and /dashboard read their DB credentials from
# these environment variables (via python-dotenv for /analytics and
# /dashboard), never hardcoded in source.
#
# The defaults below match docker-compose.yml exactly -- if you're using
# `docker compose up -d` for Postgres, this file works as-is once copied.

CPI_DB_HOST=localhost
CPI_DB_PORT=5432
CPI_DB_NAME=crime_pattern_intelligence
CPI_DB_USER=cpi_user
CPI_DB_PASSWORD=cpi_password
